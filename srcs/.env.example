# ── Inception environment (NON-secret config only) ────────────────
# DATA_PATH and DOMAIN_NAME are provided by the Makefile (exported),
# so they are intentionally not defined here.
# If you run `docker compose` directly without `make`, export them first:
#   export DATA_PATH=/home/$(whoami)/data
#   export DOMAIN_NAME=$(whoami).42.fr

# ── MariaDB ───────────────────────────────────────────────────────
MYSQL_DATABASE=<database name for WordPress>
MYSQL_USER=<username for WordPress to connect to the database>

# ── WordPress site ────────────────────────────────────────────────
# WORDPRESS_DB_NAME and WORDPRESS_DB_USER must match
# the values above.
WP_TITLE=<site title>
WORDPRESS_DB_HOST=mariadb
WORDPRESS_DB_NAME=<database name for WordPress>
WORDPRESS_DB_USER=<username for WordPress to connect to the database>

# ── WordPress admin user ──────────────────────────────────────────
WP_ADMIN_USER=<username for the admin user>
WP_ADMIN_EMAIL=<email for the admin user>

# ── WordPress second (non-admin) user ─────────────────────────────
WP_USER=<username for the second user>
WP_USER_EMAIL=<email for the second user>

# ── Redis (Bonus only) ────────────────────────────────────────────
WP_REDIS_HOST=redis
